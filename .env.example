# SentinelGate Gateway Environment Configuration

# Server configurations
SG_SERVER__HOST=0.0.0.0
SG_SERVER__PORT=8080
SG_SERVER__MAX_CONCURRENT_STREAMS=10000
SG_SERVER__TIMEOUT_MS=30000

# Upstream LLM / Gemini API configurations
SG_UPSTREAM__DEFAULT_TARGET_URL=https://generativelanguage.googleapis.com/v1beta/openai/
SG_UPSTREAM__API_KEY=YOUR_GEMINI_API_KEY_HERE
SG_UPSTREAM__MAX_RETRIES=3

# ML Engine configuration paths
SG_ML_ENGINE__ONNX_MODEL_PATH=models/deberta_injection.onnx
SG_ML_ENGINE__SLM_GGUF_PATH=models/llama_validator.gguf
SG_ML_ENGINE__PREFLIGHT_THRESHOLD=0.85
SG_ML_ENGINE__THREAD_POOL_SIZE=4
SG_ML_ENGINE__ENABLE_CUDA=false

# ClickHouse telemetry destination
SG_CLICKHOUSE__URL=http://localhost:8123
SG_CLICKHOUSE__TABLE=audit_logs
SG_CLICKHOUSE__BATCH_SIZE=500
SG_CLICKHOUSE__FLUSH_INTERVAL_MS=1000
